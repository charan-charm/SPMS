# SPMS environment configuration
# Copy this file to .env and adjust values. Never commit .env.

APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail transport: file (default development sink) | smtp | brevo (Brevo HTTPS API)
MAIL_TRANSPORT=file
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SPMS
# Real Brevo email sending requires this explicit flag set to 1 in local .env.
# Automated tests pin it to 0 and never send real email.
BREVO_ALLOW_REAL_SEND=0

# AI foundation (docs/10 D-066) — names only; never put credential
# values in this file or Git. AWS credentials resolve through the
# standard AWS SDK credential chain outside the repository.
# AI_PROVIDER: fake (default, offline) | bedrock
AI_PROVIDER=fake
AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=nvidia.nemotron-nano-12b-v2
# Short-term Bedrock API key: the VALUE belongs in the local gitignored
# .env ONLY (never here, never in Git/logs). Read at Bedrock client
# construction only (docs/10 D-066); the SDK's standard credential
# chain remains the fallback when left empty.
AWS_BEARER_TOKEN_BEDROCK=
# Real Bedrock calls require flipping this to 1 in a LOCAL .env only,
# through the dedicated manual verification script. Automated tests
# pin it to 0 and must never contact AWS.
BEDROCK_ALLOW_REAL_CALLS=0

# Mistral OCR — controlled integration test only (docs not widened;
# NOT the Bill Analyzer). The API key value belongs ONLY in the local
# gitignored .env; automated tests pin it empty and use injected fakes.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# SPMS O4 — Integration secret encryption key (32 raw bytes or 64 hex chars).
# Used for encrypting external provider credentials (e.g. GoodWe SEMS) at rest.
# Keep only in local .env; NEVER commit.
SPMS_INTEGRATION_KEY=

# GoodWe solar periodic collection interval (in seconds, minimum 60, default 300).
SOLAR_COLLECTION_INTERVAL_SECONDS=300

# Weather & Irradiance provider (docs F12): openmeteo (default, free non-commercial) | fake (offline)
WEATHER_PROVIDER=openmeteo


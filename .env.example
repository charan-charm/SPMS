# SPMS environment configuration
# Copy this file to .env and adjust values. Never commit .env.

APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# AI foundation (docs/10 D-066) — names only; never put credential
# values in this file or Git. AWS credentials resolve through the
# standard AWS SDK credential chain outside the repository.
# AI_PROVIDER: fake (default, offline) | bedrock
AI_PROVIDER=fake
AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=nvidia.nemotron-nano-12b-v2
# Real Bedrock calls require flipping this to 1 in a LOCAL .env only,
# through the dedicated manual verification script. Automated tests
# pin it to 0 and must never contact AWS.
BEDROCK_ALLOW_REAL_CALLS=0

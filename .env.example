# SPMS environment configuration
# Copy this file to .env and adjust values. Never commit .env.

APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# AI foundation (docs/10 D-066) — names only; never put credential
# values in this file or Git. AWS credentials resolve through the
# standard AWS SDK credential chain outside the repository.
# AI_PROVIDER: fake (default, offline) | bedrock
AI_PROVIDER=fake
AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=nvidia.nemotron-nano-12b-v2
# Short-term Bedrock API key: the VALUE belongs in the local gitignored
# .env ONLY (never here, never in Git/logs). Read at Bedrock client
# construction only (docs/10 D-066); the SDK's standard credential
# chain remains the fallback when left empty.
AWS_BEARER_TOKEN_BEDROCK=
# Real Bedrock calls require flipping this to 1 in a LOCAL .env only,
# through the dedicated manual verification script. Automated tests
# pin it to 0 and must never contact AWS.
BEDROCK_ALLOW_REAL_CALLS=0

# Mistral OCR — controlled integration test only (docs not widened;
# NOT the Bill Analyzer). The API key value belongs ONLY in the local
# gitignored .env; automated tests pin it empty and use injected fakes.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

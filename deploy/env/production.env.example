# SPMS Production Environment Configuration Template
# COPY TO: /var/www/spms/.env
# PERMISSIONS: chmod 640 /var/www/spms/.env && chown root:www-data /var/www/spms/.env

# Application Profile & Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain-or-ip
SPMS_DATA_ENVIRONMENT=real

# Database Configuration (Least-privilege local production user)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spms_real
DB_USERNAME=spms_app_user
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Security & Encryption (AES-256-GCM hex key - 64 hex characters)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# Session Configuration
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Mail / Notification Services
MAIL_TRANSPORT=file
# To enable Brevo in production:
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=xkeysib-...
# BREVO_REAL_SEND_ENABLED=true
# BREVO_SENDER_EMAIL=notifications@yourdomain.com
# BREVO_SENDER_NAME="SPMS Notifications"

# Weather Integration (Open-Meteo)
WEATHER_PROVIDER=open-meteo

# Solar Ingestion Settings
SOLAR_COLLECTION_INTERVAL_SECONDS=300
SOLAR_COLLECTION_TIMEOUT_SECONDS=30

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://your-domain-or-ip

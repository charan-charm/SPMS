# SPMS frontend environment configuration (F1)
# Copy to .env.local for local overrides. Only VITE_* variables are exposed
# to the browser — never place server secrets, database credentials, or
# provider credentials (GoodWe/AWS/Bedrock) here.

# Base path of the PHP REST API consumed through the centralized API client.
VITE_API_BASE_URL=/api/v1

# Local development only: where the Vite dev server proxies /api requests.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
